{
  "name": "dsh-orchestrator",
  "version": "0.1.0",
  "description": "Caveman orchestrator mode for DeepSeek Harness: plan simply, then delegate to media and text worker agents on models picked beside the composer model seat.",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "orchestrator",
    "subagent"
  ],
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-settings-controller",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js",
    "test": "node selfcheck.mjs"
  },
  "packageManager": "pnpm@12.8.1"
}
